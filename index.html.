<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/chess.js/0.10.3/chess.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/chessboard-js/1.0.0/chessboard-1.0.0.min.js"></script>

<script>
"use strict";

if (!window.jQuery || !window.Chess || !window.Chessboard) {
 document.getElementById("load-error").classList.remove("hidden");
 throw new Error("TOPICHESS: Chess libraries failed to load.");
}

const game = new Chess();
let board = null;

let gameMode = "bot";
let botElo = 800;
let humanColor = "w";
let botColor = "b";
let botThinking = false;
let botTimeout = null;

let selectedTime = 180;
let selectedMode = "Blitz";
let remainingMs = {w:180000,b:180000};
let activeClock = null;
let clockStartedAt = null;
let timerInterval = null;
let timedOut = null;

let selectedSquare = null;
let legalTargets = [];

const PIECE_VALUES = {p:100,n:320,b:330,r:500,q:900,k:20000};
const BLACK_PIECES = {p:"♟",n:"♞",b:"♝",r:"♜",q:"♛"};
const WHITE_PIECES = {p:"♙",n:"♘",b:"♗",r:"♖",q:"♕"};

/* BOARD AND TAP CONTROLS */

function clearSelection(){
 selectedSquare = null;
 legalTargets = [];
 document.querySelectorAll("#board .square-55d63").forEach(s=>{
  s.classList.remove("selected-square","legal-target","legal-capture");
 });
}

function showSelection(square){
 clearSelection();
 selectedSquare = square;
 legalTargets = game.moves({square:square,verbose:true});

 const selected = document.querySelector("#board .square-"+square);
 if(selected) selected.classList.add("selected-square");

 legalTargets.forEach(move=>{
  const target = document.querySelector("#board .square-"+move.to);
  if(target){
   target.classList.add(move.captured ? "legal-capture" : "legal-target");
  }
 });
}

function canSelectPiece(piece){
 if(!piece || piece.color !== game.turn()) return false;
 if(game.game_over() || timedOut || botThinking) return false;

 if(gameMode === "bot" && piece.color !== humanColor) return false;

 return true;
}

function handleSquareTap(square){
 if(!square || game.game_over() || timedOut || botThinking) return;
 if(gameMode === "bot" && game.turn() === botColor) return;

 const piece = game.get(square);

 if(selectedSquare){
  if(square === selectedSquare){
   clearSelection();
   return;
  }

  const legalMove = legalTargets.find(m=>m.to===square);

  if(legalMove){
   if(selectedTime > 0){
    tickClock();
    if(timedOut) return;
   }

   const move = game.move({
    from:selectedSquare,
    to:square,
    promotion:"q"
   });

   clearSelection();

   if(move){
    board.position(game.fen());
    switchClock();
    updateEverything();

    if(gameMode === "bot" && !game.game_over()){
     scheduleBotTurn();
    }
   }
   return;
  }

  if(canSelectPiece(piece)){
   showSelection(square);
   return;
  }

  clearSelection();
  return;
 }

 if(canSelectPiece(piece)){
  showSelection(square);
 }
}

board = Chessboard("board",{
 draggable:false,
 position:"start",
 orientation:"white",
 pieceTheme:"https://chessboardjs.com/img/chesspieces/wikipedia/{piece}.png"
});

$("#board").on("click", ".square-55d63", function(){
 const match = this.className.match(/square-([a-h][1-8])/);
 if(match) handleSquareTap(match[1]);
});

window.addEventListener("resize",()=>{if(board) board.resize();});

/* Prevent page scrolling only while touching the chessboard */
const boardElement = document.getElementById("board");
boardElement.addEventListener("touchmove",function(e){
 e.preventDefault();
},{passive:false});

/* COLOR SELECTION */

function startWithColor(choice){
 if(choice === "random"){
  humanColor = Math.random()<0.5 ? "w" : "b";
 }else{
  humanColor = choice;
 }
 botColor = humanColor === "w" ? "b" : "w";

 document.getElementById("color-selection").classList.add("hidden");
 document.getElementById("game-container").classList.remove("hidden");
 startFreshGame();
}

document.getElementById("choose-white").addEventListener("click",()=>startWithColor("w"));
document.getElementById("choose-black").addEventListener("click",()=>startWithColor("b"));
document.getElementById("choose-random").addEventListener("click",()=>startWithColor("random"));

/* RESET AND NEW GAME */

function cancelBotMove(){
 if(botTimeout !== null){
  clearTimeout(botTimeout);
  botTimeout = null;
 }
 botThinking = false;
}

function startFreshGame(){
 cancelBotMove();
 clearSelection();
 stopClock();
 timedOut = null;
 game.reset();

 board.orientation(gameMode === "bot" && humanColor === "b" ? "black" : "white");
 board.position("start");

 remainingMs.w = selectedTime*1000;
 remainingMs.b = selectedTime*1000;

 resetClock();
 updateEverything();
 startClock();

 if(gameMode === "bot" && botColor === "w"){
  scheduleBotTurn();
 }
}

/* MODE AND DIFFICULTY */

document.getElementById("game-mode").addEventListener("change",function(){
 gameMode = this.value;
 document.getElementById("bot-settings").classList.toggle("hidden",gameMode !== "bot");

 cancelBotMove();
 clearSelection();
 stopClock();

 if(gameMode === "bot"){
  document.getElementById("game-container").classList.add("hidden");
  document.getElementById("color-selection").classList.remove("hidden");
  game.reset();
  board.position("start");
  board.orientation("white");
  updateEverything();
  document.getElementById("game-status").textContent = "Choose your color";
 }else{
  document.getElementById("color-selection").classList.add("hidden");
  document.getElementById("game-container").classList.remove("hidden");
  startFreshGame();
 }
});

document.getElementById("bot-level").addEventListener("change",function(){
 botElo = Number(this.value);
 document.getElementById("bot-description").textContent =
  botElo <= 800
  ? "Beginner bot: simpler moves and occasional mistakes."
  : "Intermediate bot: considers more tactical replies.";

 if(gameMode === "bot" && !document.getElementById("game-container").classList.contains("hidden")){
  startFreshGame();
 }
 updatePlayerProfiles();
});

/* BOT EVALUATION */

function evaluateBoard(){
 let score = 0;
 const position = game.board();

 for(let r=0;r<8;r++){
  for(let c=0;c<8;c++){
   const p = position[r][c];
   if(!p) continue;

   let value = PIECE_VALUES[p.type];
   if(p.type !== "k"){
    const center = Math.abs(3.5-r)+Math.abs(3.5-c);
    value += Math.max(0,7-center)*2;
   }
   score += p.color === "w" ? value : -value;
  }
 }
 return score;
}

function evaluateForSideToMove(){
 const score = evaluateBoard();
 return game.turn() === "w" ? score : -score;
}

function orderMoves(moves){
 return moves.sort((a,b)=>{
  const va = a.captured ? PIECE_VALUES[a.captured] : 0;
  const vb = b.captured ? PIECE_VALUES[b.captured] : 0;
  return vb-va;
 });
}

/* BEGINNER BOT */

function beginnerBotMove(){
 const moves = game.moves({verbose:true});
 if(!moves.length) return null;

 const candidates = [];
 let best = -Infinity;

 for(const move of moves){
  game.move(move);
  let score = evaluateForSideToMove();
  const replies = game.moves({verbose:true});

  if(replies.length){
   let worst = Infinity;
   for(const reply of replies){
    game.move(reply);
    const replyScore = evaluateForSideToMove();
    game.undo();
    worst = Math.min(worst,-replyScore);
   }
   score = worst;
  }else if(game.in_checkmate()){
   score = 100000;
  }

  game.undo();
  candidates.push({move,score});
  best = Math.max(best,score);
 }

 const safe = candidates.filter(x=>x.score >= best-300);
 const weak = candidates.filter(x=>x.score < best-300);
 let pool = safe;
 if(weak.length && Math.random()<0.35) pool = weak;

 return pool[Math.floor(Math.random()*pool.length)].move;
}

/* INTERMEDIATE BOT */

function minimax(depth,alpha,beta,ply){
 if(game.in_checkmate()) return -100000+ply;
 if(game.in_draw()) return 0;
 if(depth===0) return evaluateForSideToMove();

 const moves = orderMoves(game.moves({verbose:true}));
 if(!moves.length) return 0;

 let best = -Infinity;

 for(const move of moves){
  game.move(move);
  const score = -minimax(depth-1,-beta,-alpha,ply+1);
  game.undo();

  best = Math.max(best,score);
  alpha = Math.max(alpha,score);
  if(alpha>=beta) break;
 }
 return best;
}

function intermediateBotMove(){
 const moves = orderMoves(game.moves({verbose:true}));
 if(!moves.length) return null;

 let bestMove = null;
 let bestScore = -Infinity;
 let alpha = -Infinity;
 const beta = Infinity;

 for(const move of moves){
  game.move(move);
  const score = -minimax(2,-beta,-alpha,1);
  game.undo();

  if(score>bestScore){
   bestScore = score;
   bestMove = move;
  }
  alpha = Math.max(alpha,score);
 }
 return bestMove;
}

function calculateBotMove(){
 return botElo<=800 ? beginnerBotMove() : intermediateBotMove();
}

/* BOT TURN */

function scheduleBotTurn(){
 if(gameMode!=="bot" || game.game_over() || timedOut || game.turn()!==botColor) return;

 cancelBotMove();
 botThinking = true;
 clearSelection();
 updateStatus();

 botTimeout = setTimeout(()=>{
  botTimeout = null;
  makeBotMove();
 },450);
}

function makeBotMove(){
 if(gameMode!=="bot" || game.game_over() || timedOut || game.turn()!==botColor){
  botThinking = false;
  return;
 }

 if(selectedTime>0){
  tickClock();
  if(timedOut){
   botThinking = false;
   return;
  }
 }

 const chosen = calculateBotMove();

 if(selectedTime>0){
  tickClock();
  if(timedOut){
   botThinking = false;
   return;
  }
 }

 if(!chosen){
  botThinking = false;
  updateEverything();
  return;
 }

 const move = game.move({
  from:chosen.from,
  to:chosen.to,
  promotion:"q"
 });

 botThinking = false;
 if(!move){
  updateEverything();
  return;
 }

 board.position(game.fen());
 switchClock();
 updateEverything();
}

/* CHESS CLOCK */

function formatClock(ms){
 const seconds = Math.ceil(Math.max(0,ms)/1000);
 const minutes = Math.floor(seconds/60);
 const remainder = seconds%60;
 return String(minutes).padStart(2,"0")+":"+String(remainder).padStart(2,"0");
}

function renderClocks(){
 const white = document.getElementById("white-clock");
 const black = document.getElementById("black-clock");

 white.textContent = selectedTime===0 ? "∞" : formatClock(remainingMs.w);
 black.textContent = selectedTime===0 ? "∞" : formatClock(remainingMs.b);

 white.classList.toggle("active",activeClock==="w");
 black.classList.toggle("active",activeClock==="b");
 white.classList.toggle("expired",timedOut==="w");
 black.classList.toggle("expired",timedOut==="b");
}

function stopClock(){
 if(timerInterval!==null){
  clearInterval(timerInterval);
  timerInterval = null;
 }

 if(activeClock && clockStartedAt!==null && selectedTime>0){
  const elapsed = performance.now()-clockStartedAt;
  remainingMs[activeClock] = Math.max(0,remainingMs[activeClock]-elapsed);
 }

 activeClock = null;
 clockStartedAt = null;
 renderClocks();
}

function startClock(){
 if(selectedTime===0 || timedOut || game.game_over()){
  renderClocks();
  return;
 }

 if(timerInterval!==null) clearInterval(timerInterval);

 activeClock = game.turn();
 clockStartedAt = performance.now();
 timerInterval = setInterval(tickClock,100);
 renderClocks();
}

function tickClock(){
 if(!activeClock || selectedTime===0 || timedOut) return;

 const now = performance.now();
 const elapsed = now-clockStartedAt;
 remainingMs[activeClock] -= elapsed;
 clockStartedAt = now;

 if(remainingMs[activeClock]<=0){
  remainingMs[activeClock] = 0;
  handleTimeout(activeClock);
  return;
 }
 renderClocks();
}

function handleTimeout(player){
 if(timedOut) return;

 if(timerInterval!==null){
  clearInterval(timerInterval);
  timerInterval = null;
 }

 timedOut = 

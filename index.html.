<style>
*{box-sizing:border-box}
body{margin:0;background:#262522;color:white;font-family:Arial,sans-serif}
.panel{background:#302e2b;border:1px solid #45433f;border-radius:12px}
#board{width:100%;max-width:600px;margin:auto;touch-action:none;user-select:none;-webkit-user-select:none;-webkit-touch-callout:none;overscroll-behavior:contain}
#board .square-55d63{touch-action:none}
#board .square-55d63.selected-square{box-shadow:inset 0 0 0 5px #f6e65b}
#board .square-55d63.legal-target{position:relative}
#board .square-55d63.legal-target:after{content:"";position:absolute;width:28%;height:28%;border-radius:50%;background:rgba(30,30,30,.35);top:36%;left:36%;pointer-events:none}
#board .square-55d63.legal-capture:after{content:"";position:absolute;inset:0;border:5px solid rgba(30,30,30,.35);border-radius:50%;background:transparent;pointer-events:none}
.player{background:#303138;border:2px solid transparent;border-radius:10px;padding:10px;display:flex;align-items:center;gap:12px}
.player.active{border-color:#81b64c;background:#353c32}
.avatar{width:42px;height:42px;border-radius:9px;display:flex;align-items:center;justify-content:center;font-size:29px;flex-shrink:0}
.white-avatar{background:#eee;color:#222}
.black-avatar{background:#181818;color:white}
.btn{background:#45433f;padding:11px 14px;border-radius:8px;font-weight:bold}
.btn:hover{background:#5b5852}
.green{background:#81b64c}
.green:hover{background:#729f43}
.color-btn{background:#303138;border:2px solid #45464d;border-radius:12px;padding:18px 8px;display:flex;flex-direction:column;align-items:center;gap:8px;font-weight:bold}
.color-btn:hover{border-color:#81b64c;background:#3b4435}
.clock{font:bold 26px monospace;background:#181818;padding:8px 12px;border-radius:8px;min-width:100px;text-align:center}
.clock.active{background:#81b64c}
.clock.expired{background:#a83232}
.capture-list{font-size:25px;min-height:34px;display:flex;gap:3px;flex-wrap:wrap}
.move-row{display:grid;grid-template-columns:35px 1fr 1fr;padding:9px 6px;border-radius:5px;font-size:14px}
.move-row:nth-child(even){background:#303138}
.move-san{text-align:center;font-weight:bold}
.latest{color:#a3d977}
#move-history{max-height:260px;overflow-y:auto}
.hidden{display:none!important}
@media(max-width:700px){
 .layout{grid-template-columns:1fr!important}
 #board{max-width:100%}
 .clock{font-size:22px;min-width:85px}
}
</style>
</head>


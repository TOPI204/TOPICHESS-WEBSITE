<section id="game-container" class="hidden">
 <div class="layout grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_340px] gap-5">

  <div class="min-w-0">
   <div class="panel p-3 mb-3 flex justify-between items-center gap-2">
    <div class="flex items-center gap-2">
     <div class="avatar black-avatar">♚</div>
     <div>

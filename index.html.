    <div id="game-status" class="font-bold text-green-400">Choose your color</div>
    <div id="mode-display" class="text-xs text-gray-400 mt-2">Play Against Bot</div>
   </div>

   <div class="panel p-4">
    <div class="flex justify-between mb-3">
